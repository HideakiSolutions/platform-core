{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-core/authorization/decision",
  "title": "Authorization Decision",
  "description": "Stack-agnostic authorize(subject, action, resource, context) request and its decision. One wire shape that unifies RBAC (subject.roles), ABAC (subject/resource/context attributes) and ReBAC (resource.relations), so any service and any policy engine (OPA, Cedar, OpenFGA) can emit and consume the same decision. Decisions are auditable via matched_policy and may carry obligations the caller must enforce.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "description": "The authorize() call.",
      "properties": {
        "subject": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["user", "service", "system"] },
            "tenant_id": { "type": "string" },
            "roles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "RBAC role claims (e.g. Keycloak realm roles)."
            },
            "attributes": {
              "type": "object",
              "description": "ABAC subject attributes (department, clearance, ...)."
            }
          },
          "required": ["id", "type"]
        },
        "action": {
          "type": "string",
          "description": "Dot-notation action, e.g. 'billing.invoice.void'."
        },
        "resource": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "tenant_id": { "type": "string" },
            "owner_id": { "type": "string", "description": "ReBAC: principal that owns the resource." },
            "attributes": {
              "type": "object",
              "description": "ABAC resource attributes (classification, amount, ...)."
            },
            "relations": {
              "type": "array",
              "description": "ReBAC: relation tuples between principals and this resource.",
              "items": {
                "type": "object",
                "properties": {
                  "relation": { "type": "string", "description": "e.g. 'owner', 'editor', 'manager_of', 'approver_of'." },
                  "subject_id": { "type": "string" }
                },
                "required": ["relation", "subject_id"]
              }
            }
          },
          "required": ["type"]
        },
        "context": {
          "type": "object",
          "description": "ABAC environment attributes (ip, time, mfa, amount, ...)."
        },
        "correlation_id": { "type": "string" }
      },
      "required": ["subject", "action", "resource"]
    },
    "result": {
      "type": "object",
      "description": "The decision.",
      "properties": {
        "effect": { "type": "string", "enum": ["permit", "deny"] },
        "reason": { "type": "string" },
        "matched_policy": {
          "type": "string",
          "description": "Policy/rule id that determined the effect (audit trail)."
        },
        "model": {
          "type": "string",
          "enum": ["rbac", "abac", "rebac", "hybrid"],
          "description": "Which model produced the decisive match."
        },
        "obligations": {
          "type": "array",
          "description": "Side-effects the caller MUST enforce (field masking, step-up auth, ...).",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["mask", "filter", "step_up_auth", "log", "notify"] },
              "detail": { "type": "object" }
            },
            "required": ["type"]
          }
        },
        "evaluated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["effect"]
    }
  },
  "required": ["request", "result"]
}
