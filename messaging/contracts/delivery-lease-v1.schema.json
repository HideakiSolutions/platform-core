{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-core/messaging/delivery-lease/v1",
  "title": "Delivery lease request v1",
  "description": "Accepted (ADR-012, 2026-10-23; amended 2026-11-04), not admitted. Transport-neutral lease request. Envelope bytes remain owned by ECP messaging.event-envelope@0.1.0. Behavioral guarantees are normative in messaging/docs/delivery-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
