      "const": "platform-core/messaging/delivery-lease/v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "maxLength": 128
    },
    "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "maxLength": 128
    },
    "message_id": {
