|0{8}-0{4}-0{4}-0{4}-0{10}[1-9a-fA-F][0-9a-fA-F]|0{8}-0{4}-0{4}-0{4}-0{11}[1-9a-fA-F])$"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lease_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "$schema",
    "contract_version",
    "tenant",
    "consumer",
    "message_id",
    "envelope_sha256",
    "lease_duration_ms",
    "max_attempts"
  ]
}
