{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hideakisolutions.local/capabilities/ai.provider-access/inference-request.schema.json",
  "title": "AI Inference Request",
  "description": "Provider-neutral bounded text inference. Caller cancellation and configured deadlines apply to account inspection and generation without retry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^ \\t\\r\\n]"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^ \\t\\r\\n]"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^ \\t\\r\\n]"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^ \\t\\r\\n]"
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    }
  },
  "required": [
    "model",
    "messages",
    "max_output_tokens",
    "correlation_id"
  ]
}
