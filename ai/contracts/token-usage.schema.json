{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-core/ai/token-usage",
  "title": "AI Token Usage",
  "description": "Per-call LLM token usage and cost record for AI telemetry and cost governance. Cost is expressed in integer micro-units of the currency (millionths) to avoid floating-point drift.",
  "type": "object",
  "properties": {
    "usage_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "description": "Model id, e.g. 'claude-opus-4-8' or 'gpt-4.1'" },
    "provider": { "type": "string", "description": "Provider, e.g. 'anthropic', 'openai'" },
    "operation": { "type": "string", "description": "Operation, e.g. 'chat.completions'" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "cached_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cost": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "default": "USD" },
        "input_micros": { "type": "integer", "description": "Input cost in millionths of one currency unit" },
        "output_micros": { "type": "integer", "description": "Output cost in millionths of one currency unit" },
        "total_micros": { "type": "integer", "description": "Total cost in millionths of one currency unit" }
      },
      "required": ["currency", "total_micros"]
    },
    "tenant_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "agent": { "type": "string", "description": "Logical agent/component that incurred the usage" },
    "metadata": { "type": "object" }
  },
  "required": ["usage_id", "timestamp", "model", "input_tokens", "output_tokens"]
}
