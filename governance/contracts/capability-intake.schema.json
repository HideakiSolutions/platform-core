{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-core/governance/capability-intake",
  "title": "Platform Capability Intake",
  "description": "Fail-closed decision record required before a product creates, consumes, extends or promotes a cross-cutting capability.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "const": "platform-core/governance/capability-intake" },
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "format": "uuid" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "need": { "type": "string", "minLength": 1 }
      },
      "required": ["repository", "path", "need"]
    },
    "classification": {
      "type": "string",
      "enum": ["platform", "partner", "shared", "product-local"]
    },
    "decision": {
      "type": "string",
      "enum": ["consume", "extend", "promote", "keep-local", "exception"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "owner": {
          "type": "string",
          "enum": ["platform-core", "backend-core", "frontend-core", "mobile-core", "design-system-core", "provider-protocol", "partner-contracts"]
        },
        "contract_id": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 }
      },
      "required": ["capability_id", "owner", "contract_id"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry_checked": { "type": "boolean", "const": true },
        "existing_implementations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "candidate_consumers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "strategic_adr": { "type": "string", "minLength": 1 },
        "compatibility_assessment": { "type": "string", "minLength": 1 }
      },
      "required": ["registry_checked", "existing_implementations", "candidate_consumers", "compatibility_assessment"]
    },
    "hardening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_domains": {
          "type": "array",
          "items": { "type": "string", "enum": ["public-contract", "money", "identity", "authorization", "tenancy", "pii", "secrets", "provider", "data", "runtime"] },
          "uniqueItems": true
        },
        "failure_mode": { "type": "string", "enum": ["fail-closed", "fail-open", "caller-owned"] },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rollback": { "type": "string", "minLength": 1 }
      },
      "required": ["risk_domains", "failure_mode", "verification", "rollback"]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["reference"]
    }
  },
  "required": ["$schema", "schema_version", "request_id", "submitted_at", "source", "classification", "decision", "evidence", "hardening", "rationale"],
  "allOf": [
    {
      "if": { "properties": { "decision": { "enum": ["consume", "extend", "promote"] } }, "required": ["decision"] },
      "then": { "properties": { "target": true }, "required": ["target"] }
    },
    {
      "if": { "properties": { "decision": { "const": "promote" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "evidence": {
            "anyOf": [
              { "type": "object", "properties": { "candidate_consumers": { "type": "array", "minItems": 2 } } },
              { "type": "object", "properties": { "strategic_adr": true }, "required": ["strategic_adr"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "exception" } }, "required": ["decision"] },
      "then": { "properties": { "approval": true }, "required": ["approval"] }
    }
  ]
}
