{
  "name": "@hideakisolutions/platform-contract-validation",
  "private": true,
  "scripts": {
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:capability-graph": "node scripts/validate-platform-capability-graph.mjs --self-test",
    "validate": "npm run validate:contracts && npm run test:contract-stubs && npm run validate:capability-graph && npm run test:delivery-leases && npm run test:capability-drift && npm run validate:capability-authority && npm run test:capability-authority && npm run validate:release-ledger && npm run test:release-ledger && npm run validate:ledger-authority && npm run test:ledger-authority && npm run validate:scorecard && npm run test:scorecard && npm run validate:workflow-policy && npm run test:workflow-policy && npm run test:supply-chain-gates && npm run test:provider-aliases && npm run test:provider-authority",
    "test:capability-drift": "node tools/capability-drift/test.mjs && node --test tools/capability-drift/cli.test.mjs",
    "test:contract-stubs": "node --test scripts/test-contract-stubs.mjs",
    "test:delivery-leases": "node --test scripts/test-delivery-leases.test.mjs",
    "validate:capability-authority": "node scripts/validate-capability-authority.mjs",
    "test:capability-authority": "node --test scripts/test-capability-authority.test.mjs",
    "validate:release-ledger": "node scripts/validate-release-ledger.mjs",
    "test:release-ledger": "node --test scripts/test-release-ledger.test.mjs",
    "validate:ledger-authority": "node scripts/validate-ledger-authority.mjs",
    "test:ledger-authority": "node --test scripts/test-ledger-authority.test.mjs",
    "generate:scorecard": "node scripts/generate-capability-scorecard.mjs",
    "validate:scorecard": "node scripts/generate-capability-scorecard.mjs --check",
    "test:scorecard": "node --test scripts/test-capability-scorecard.test.mjs",
    "validate:workflow-policy": "node scripts/validate-workflow-policy.mjs",
    "test:workflow-policy": "node --test scripts/test-workflow-policy.test.mjs",
    "test:supply-chain-gates": "node --test scripts/test-supply-chain-gates.test.mjs",
    "test:provider-aliases": "node scripts/test-provider-contract-aliases.mjs",
    "test:provider-authority": "node --test scripts/test-provider-access-authority.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
